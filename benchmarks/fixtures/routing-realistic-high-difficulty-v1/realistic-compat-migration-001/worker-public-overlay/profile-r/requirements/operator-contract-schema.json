{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commands"],
  "properties": {
    "schema_version": {"const": 1},
    "commands": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "argv", "precondition", "success_exit_codes", "failure_map", "allowed_source_states", "allowed_terminal_states", "stop_before_next_dispatch", "implementation_symbol", "public_schema"],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "precondition": {"type": "string", "minLength": 1},
          "success_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "failure_map": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
          "allowed_source_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "allowed_terminal_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "stop_before_next_dispatch": {"type": "boolean"},
          "implementation_symbol": {"type": "string", "minLength": 1},
          "public_schema": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "$defs": {
    "ExpectedWriteFiles": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "ExpectedWriteFiles",
      "type": "object"
    },
    "FixtureComplexity": {
      "additionalProperties": false,
      "properties": {
        "check_count": {
          "minimum": 0,
          "title": "Check Count",
          "type": "integer"
        },
        "dependency_depth": {
          "minimum": 1,
          "title": "Dependency Depth",
          "type": "integer"
        },
        "dependency_edges": {
          "minimum": 0,
          "title": "Dependency Edges",
          "type": "integer"
        },
        "expected_write_files": {
          "$ref": "#/$defs/ExpectedWriteFiles"
        },
        "failure_profile": {
          "enum": [
            "normal",
            "omission_risk",
            "compatibility_risk",
            "injected"
          ],
          "title": "Failure Profile",
          "type": "string"
        },
        "handoff_kind": {
          "enum": [
            "none",
            "filesystem_implicit",
            "declared_single",
            "declared_multiple"
          ],
          "title": "Handoff Kind",
          "type": "string"
        },
        "max_fan_in": {
          "minimum": 0,
          "title": "Max Fan In",
          "type": "integer"
        },
        "scope_overlap": {
          "enum": [
            "not_applicable",
            "disjoint",
            "partial",
            "shared"
          ],
          "title": "Scope Overlap",
          "type": "string"
        },
        "solution_ambiguity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Solution Ambiguity",
          "type": "string"
        },
        "task_count": {
          "minimum": 1,
          "title": "Task Count",
          "type": "integer"
        },
        "verification_kind": {
          "enum": [
            "public_to_worker",
            "post_hoc_property",
            "judge_only_verified",
            "judge_only_unverified",
            "partial",
            "human"
          ],
          "title": "Verification Kind",
          "type": "string"
        },
        "worker_read_bytes": {
          "minimum": 0,
          "title": "Worker Read Bytes",
          "type": "integer"
        },
        "worker_read_files": {
          "minimum": 0,
          "title": "Worker Read Files",
          "type": "integer"
        },
        "write_modules": {
          "minimum": 1,
          "title": "Write Modules",
          "type": "integer"
        }
      },
      "required": [
        "task_count",
        "dependency_depth",
        "dependency_edges",
        "max_fan_in",
        "worker_read_files",
        "worker_read_bytes",
        "expected_write_files",
        "write_modules",
        "check_count",
        "handoff_kind",
        "scope_overlap",
        "verification_kind",
        "failure_profile",
        "solution_ambiguity"
      ],
      "title": "FixtureComplexity",
      "type": "object"
    },
    "FixtureManifestSelection": {
      "additionalProperties": false,
      "properties": {
        "fixture_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fixture Ids",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "fixture_ids"
      ],
      "title": "FixtureManifestSelection",
      "type": "object"
    },
    "FixtureProfileDeclaration": {
      "additionalProperties": false,
      "properties": {
        "complexity": {
          "$ref": "#/$defs/FixtureComplexity"
        },
        "fixture_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Fixture Id",
          "type": "string"
        }
      },
      "required": [
        "fixture_id",
        "complexity"
      ],
      "title": "FixtureProfileDeclaration",
      "type": "object"
    },
    "RoutingS1CellDeclaration": {
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Fixture Id",
          "type": "string"
        },
        "repetition": {
          "const": 1,
          "default": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "variant_id": {
          "enum": [
            "c2",
            "b1"
          ],
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "fixture_id",
        "variant_id"
      ],
      "title": "RoutingS1CellDeclaration",
      "type": "object"
    },
    "RoutingS1StageManifest": {
      "additionalProperties": false,
      "properties": {
        "allowed_outcomes": {
          "items": {
            "enum": [
              "CALIBRATION_PASS",
              "CALIBRATION_STOP",
              "CALIBRATION_INCONCLUSIVE"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Allowed Outcomes",
          "type": "array"
        },
        "baseline_variant": {
          "const": "c2",
          "title": "Baseline Variant",
          "type": "string"
        },
        "candidate_variants": {
          "items": {
            "const": "b1",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Candidate Variants",
          "type": "array"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/RoutingS1CellDeclaration"
          },
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "fixture_manifests": {
          "items": {
            "$ref": "#/$defs/FixtureManifestSelection"
          },
          "minItems": 1,
          "title": "Fixture Manifests",
          "type": "array"
        },
        "planned_live_model_turns": {
          "minimum": 1,
          "title": "Planned Live Model Turns",
          "type": "integer"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/FixtureProfileDeclaration"
          },
          "minItems": 1,
          "title": "Profiles",
          "type": "array"
        },
        "purpose": {
          "const": "calibration_only",
          "title": "Purpose",
          "type": "string"
        },
        "route_decision_allowed": {
          "const": false,
          "default": false,
          "title": "Route Decision Allowed",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stage_id": {
          "const": "s1-baseline",
          "title": "Stage Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "implementation_candidate",
            "frozen_before_execution"
          ],
          "title": "Status",
          "type": "string"
        },
        "variants": {
          "items": {
            "enum": [
              "c2",
              "b1"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "stage_id",
        "status",
        "purpose",
        "fixture_manifests",
        "variants",
        "baseline_variant",
        "candidate_variants",
        "profiles",
        "cells",
        "planned_live_model_turns",
        "allowed_outcomes"
      ],
      "title": "RoutingS1StageManifest",
      "type": "object"
    },
    "RoutingS2CellDeclaration": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "pattern": "^cell_s2_[ab]_[12]_(?:c2|b1)$",
          "title": "Cell Id",
          "type": "string"
        },
        "fixture_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Fixture Id",
          "type": "string"
        },
        "profile_alias": {
          "enum": [
            "a",
            "b"
          ],
          "title": "Profile Alias",
          "type": "string"
        },
        "repetition": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Repetition",
          "type": "integer"
        },
        "variant_id": {
          "enum": [
            "c2",
            "b1"
          ],
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "profile_alias",
        "fixture_id",
        "variant_id"
      ],
      "title": "RoutingS2CellDeclaration",
      "type": "object"
    },
    "RoutingS2StageManifest": {
      "additionalProperties": false,
      "properties": {
        "allowed_outcomes": {
          "items": {
            "enum": [
              "S2_OBSERVATION_READY",
              "S2_POLICY_READY",
              "S2_EXPANSION_REQUIRED",
              "S2_INCONCLUSIVE",
              "S2_STOP",
              "S2_INCOMPLETE"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Allowed Outcomes",
          "type": "array"
        },
        "b1_retry_resume_reserve_turns": {
          "const": 3,
          "title": "B1 Retry Resume Reserve Turns",
          "type": "integer"
        },
        "base_live_model_turns": {
          "const": 12,
          "title": "Base Live Model Turns",
          "type": "integer"
        },
        "baseline_variant": {
          "const": "c2",
          "title": "Baseline Variant",
          "type": "string"
        },
        "candidate_variants": {
          "items": {
            "const": "b1",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Candidate Variants",
          "type": "array"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/RoutingS2CellDeclaration"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Cells",
          "type": "array"
        },
        "fixture_manifests": {
          "items": {
            "$ref": "#/$defs/FixtureManifestSelection"
          },
          "minItems": 1,
          "title": "Fixture Manifests",
          "type": "array"
        },
        "max_actual_live_model_turns": {
          "const": 15,
          "title": "Max Actual Live Model Turns",
          "type": "integer"
        },
        "profile_aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "a",
              "b"
            ]
          },
          "title": "Profile Aliases",
          "type": "object"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/FixtureProfileDeclaration"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Profiles",
          "type": "array"
        },
        "purpose": {
          "const": "profile_routing",
          "title": "Purpose",
          "type": "string"
        },
        "route_decision_allowed": {
          "const": true,
          "title": "Route Decision Allowed",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stage_id": {
          "const": "s2-intermediate",
          "title": "Stage Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "implementation_candidate",
            "frozen_before_execution"
          ],
          "title": "Status",
          "type": "string"
        },
        "variants": {
          "items": {
            "enum": [
              "c2",
              "b1"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "stage_id",
        "status",
        "purpose",
        "fixture_manifests",
        "variants",
        "baseline_variant",
        "candidate_variants",
        "profile_aliases",
        "profiles",
        "cells",
        "base_live_model_turns",
        "b1_retry_resume_reserve_turns",
        "max_actual_live_model_turns",
        "route_decision_allowed",
        "allowed_outcomes"
      ],
      "title": "RoutingS2StageManifest",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "s1-baseline": "#/$defs/RoutingS1StageManifest",
      "s2-intermediate": "#/$defs/RoutingS2StageManifest"
    },
    "propertyName": "stage_id"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RoutingS1StageManifest"
    },
    {
      "$ref": "#/$defs/RoutingS2StageManifest"
    }
  ]
}

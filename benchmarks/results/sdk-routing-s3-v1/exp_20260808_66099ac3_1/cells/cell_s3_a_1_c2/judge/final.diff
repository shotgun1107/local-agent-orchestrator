diff --git a/schema/model.py b/schema/model.py
index 160d8e3..11614e0 100644
--- a/schema/model.py
+++ b/schema/model.py
@@ -1,8 +1,58 @@
-"""Implementation target."""
+"""The strict public v2 payload schema."""
 
-PUBLIC_FIELDS = ()
-ALIASES = {}
+from .errors import ContractError, ERROR_CODES
+
+
+PUBLIC_FIELDS = ("endpoint", "max_retries", "timeout_seconds", "mode", "version")
+ALIASES = {
+    "url": "endpoint",
+    "retries": "max_retries",
+    "timeout": "timeout_seconds",
+}
+
+
+def _error(name, message):
+    raise ContractError(ERROR_CODES[name], message)
 
 
 def validate(payload):
-    raise NotImplementedError
+    """Validate *payload* and return a new canonical v2 dictionary.
+
+    Aliases are normalized only when their canonical counterpart is absent.
+    This deliberately performs no coercion so callers cannot accidentally turn
+    an old, malformed wire value into a valid one.
+    """
+    if not isinstance(payload, dict):
+        _error("unknown_field", "payload must be an object")
+
+    unknown = set(payload).difference(PUBLIC_FIELDS).difference(ALIASES)
+    if unknown:
+        _error("unknown_field", "unknown field: {}".format(sorted(unknown)[0]))
+
+    for alias, canonical in ALIASES.items():
+        if alias in payload and canonical in payload:
+            _error("alias_conflict", "{} conflicts with {}".format(alias, canonical))
+
+    canonical = dict(payload)
+    for alias, field in ALIASES.items():
+        if alias in canonical:
+            canonical[field] = canonical.pop(alias)
+
+    for field in PUBLIC_FIELDS:
+        if field not in canonical:
+            _error("missing_field", "missing field: {}".format(field))
+
+    if not isinstance(canonical["endpoint"], str):
+        _error("missing_field", "endpoint must be a string")
+    for field in ("max_retries", "timeout_seconds"):
+        value = canonical[field]
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            _error("missing_field", "{} must be a non-negative integer".format(field))
+    if canonical["mode"] not in ("safe", "fast"):
+        _error("invalid_mode", "mode must be 'safe' or 'fast'")
+    if isinstance(canonical["version"], bool) or canonical["version"] != 2:
+        _error("missing_field", "version must be the integer 2")
+    if not isinstance(canonical["version"], int):
+        _error("missing_field", "version must be the integer 2")
+
+    return {field: canonical[field] for field in PUBLIC_FIELDS}

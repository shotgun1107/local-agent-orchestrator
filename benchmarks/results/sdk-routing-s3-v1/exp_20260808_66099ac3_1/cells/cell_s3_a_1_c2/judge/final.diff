--- a/migration/legacy.py
+++ b/migration/legacy.py
@@ -1,5 +1,30 @@
-"""Implementation target."""
+"""Normalization of the v1 wire-format names used by older callers."""
+
+from schema.errors import ContractError, ERROR_CODES
+from schema.model import ALIASES
 
 
 def normalize_legacy(payload):
-    raise NotImplementedError
+    """Return a copied v2-shaped payload from a v1 or v2 payload.
+
+    Alias handling deliberately mirrors the public schema: an alias may fill a
+    missing canonical field, but supplying both names is ambiguous and fails.
+    Adding the version marker here makes this operation safe to apply more
+    than once while leaving the caller's object untouched.
+    """
+    if not isinstance(payload, dict):
+        raise ContractError(ERROR_CODES["unknown_field"], "payload must be an object")
+
+    normalized = dict(payload)
+    for alias, canonical in ALIASES.items():
+        if alias in normalized and canonical in normalized:
+            raise ContractError(
+                ERROR_CODES["alias_conflict"],
+                "{} conflicts with {}".format(alias, canonical),
+            )
+        if alias in normalized:
+            normalized[canonical] = normalized.pop(alias)
+
+    if "version" not in normalized:
+        normalized["version"] = 2
+    return normalized

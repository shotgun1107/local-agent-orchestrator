diff --git a/schema/model.py b/schema/model.py
index 160d8e3..9691c0a 100644
--- a/schema/model.py
+++ b/schema/model.py
@@ -1,8 +1,61 @@
-"""Implementation target."""
+"""Canonical public schema and strict payload validation."""
 
-PUBLIC_FIELDS = ()
-ALIASES = {}
+from .errors import ContractError, ERROR_CODES
+
+
+PUBLIC_FIELDS = (
+    "endpoint",
+    "max_retries",
+    "timeout_seconds",
+    "mode",
+    "version",
+)
+
+ALIASES = {
+    "url": "endpoint",
+    "retries": "max_retries",
+    "timeout": "timeout_seconds",
+}
+
+
+def _error(name, message):
+    raise ContractError(ERROR_CODES[name], message)
 
 
 def validate(payload):
-    raise NotImplementedError
+    """Return *payload* as a canonical v2 object without coercing values.
+
+    Deprecated aliases are translated only if their canonical counterpart is not
+    supplied.  The returned dictionary always uses the documented field order.
+    """
+    if not isinstance(payload, dict):
+        _error("missing_field", "payload must be an object")
+
+    allowed = set(PUBLIC_FIELDS) | set(ALIASES)
+    for key in payload:
+        if key not in allowed:
+            _error("unknown_field", "unknown field: %s" % key)
+
+    values = dict(payload)
+    for alias, canonical in ALIASES.items():
+        if alias in values:
+            if canonical in values:
+                _error("alias_conflict", "cannot provide both %s and %s" % (alias, canonical))
+            values[canonical] = values.pop(alias)
+
+    for field in PUBLIC_FIELDS:
+        if field not in values:
+            _error("missing_field", "missing field: %s" % field)
+
+    if not isinstance(values["endpoint"], str):
+        _error("missing_field", "endpoint must be a string")
+    for field in ("max_retries", "timeout_seconds"):
+        value = values[field]
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            _error("missing_field", "%s must be a non-negative integer" % field)
+    if values["mode"] not in ("safe", "fast") or not isinstance(values["mode"], str):
+        _error("invalid_mode", "mode must be 'safe' or 'fast'")
+    if isinstance(values["version"], bool) or not isinstance(values["version"], int) or values["version"] != 2:
+        _error("missing_field", "version must be the integer 2")
+
+    return {field: values[field] for field in PUBLIC_FIELDS}

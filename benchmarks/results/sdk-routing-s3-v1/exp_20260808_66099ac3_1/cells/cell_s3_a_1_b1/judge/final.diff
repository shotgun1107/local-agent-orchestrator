+
+from schema.model import validate
 
 
 def normalize_legacy(payload):
-    raise NotImplementedError
+    """Return a validated canonical v2 payload without changing *payload*.
+
+    Legacy payloads predate the explicit version marker.  Field aliases are
+    deliberately left for :func:`schema.model.validate` so its public
+    collision and unknown-field error behaviour remains the single source of
+    truth.

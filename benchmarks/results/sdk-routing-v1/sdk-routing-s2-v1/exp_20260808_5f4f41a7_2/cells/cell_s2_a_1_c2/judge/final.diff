diff --git a/cli/config_cli.py b/cli/config_cli.py
index 3b4b2c1..828fc5c 100644
--- a/cli/config_cli.py
+++ b/cli/config_cli.py
@@ -1 +1,25 @@
-raise NotImplementedError("implement cli.config_cli.main")
+"""Command-line entry point for canonicalizing configuration JSON."""
+
+import json
+from collections.abc import Sequence
+from pathlib import Path
+
+from runtime.parser import parse
+from runtime.serializer import serialize
+
+
+def main(argv: Sequence[str]) -> int:
+    """Read one configuration file and write its canonical v2 JSON."""
+    try:
+        if len(argv) != 1:
+            raise ValueError("expected exactly one configuration path")
+        payload = Path(argv[0]).read_text(encoding="utf-8")
+        print(serialize(parse(payload)))
+        return 0
+    except ValueError as exc:
+        print(json.dumps(
+            {"error": {"kind": type(exc).__name__}},
+            sort_keys=True,
+            separators=(",", ":"),
+        ))
+        return 2
diff --git a/migration/legacy.py b/migration/legacy.py
index 85791b1..8e766eb 100644
--- a/migration/legacy.py
+++ b/migration/legacy.py
@@ -1 +1,18 @@
-raise NotImplementedError("implement migration.legacy.migrate")
+"""Migration from the legacy v1 configuration shape to v2."""
+
+from collections.abc import Mapping
+
+from schema.model import validate
+
+
+def migrate(mapping: Mapping[str, object]) -> dict[str, object]:
+    """Return a validated v2 copy of *mapping* without changing the caller's map."""
+    validated = validate(mapping)
+    if validated["version"] == 2:
+        return dict(validated)
+    return {
+        "version": 2,
+        "timeout_seconds": validated["timeout"],
+        "max_retries": validated["retries"],
+        "endpoint": validated["endpoint"],
+    }
diff --git a/runtime/parser.py b/runtime/parser.py
index 4fed194..4b879d5 100644
--- a/runtime/parser.py
+++ b/runtime/parser.py
@@ -1 +1,19 @@
-raise NotImplementedError("implement runtime.parser.parse")
+"""Parsing for configuration payloads."""
+
+import json
+from collections.abc import Mapping
+
+from migration.legacy import migrate
+from schema.errors import InvalidTypeError
+
+
+def parse(payload: Mapping[str, object] | str) -> dict[str, object]:
+    """Parse a mapping or JSON object string and return a validated v2 copy."""
+    if isinstance(payload, str):
+        try:
+            payload = json.loads(payload)
+        except (TypeError, json.JSONDecodeError) as exc:
+            raise InvalidTypeError("payload must be valid JSON object text") from exc
+    if not isinstance(payload, Mapping):
+        raise InvalidTypeError("payload must be a mapping or JSON object text")
+    return migrate(payload)
diff --git a/runtime/serializer.py b/runtime/serializer.py
index 9f5ed1f..7a3487a 100644
--- a/runtime/serializer.py
+++ b/runtime/serializer.py
@@ -1 +1,16 @@
-raise NotImplementedError("implement runtime.serializer.serialize")
+"""Canonical JSON serialization for configuration mappings."""
+
+import json
+from collections.abc import Mapping
+
+from runtime.parser import parse
+
+
+def serialize(mapping: Mapping[str, object]) -> str:
+    """Return the validated v2 configuration in canonical JSON form."""
+    return json.dumps(
+        parse(mapping),
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )

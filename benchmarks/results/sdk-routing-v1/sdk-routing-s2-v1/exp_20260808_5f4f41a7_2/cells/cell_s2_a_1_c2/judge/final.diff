+"""Public exceptions raised while validating configuration mappings."""
+
+
+class UnknownVersionError(ValueError):
+    """Raised when a configuration version is not supported."""
+
+
+class DuplicateKeyError(ValueError):
+    """Raised when distinct input keys normalize to the same key."""
+
+
+class UnknownKeyError(ValueError):
+    """Raised when a key is not part of the selected version's contract."""
+
+
+class InvalidTypeError(ValueError):
+    """Raised when a configuration value has an invalid type."""
diff --git a/schema/model.py b/schema/model.py
index c191087..9cc5568 100644
--- a/schema/model.py
+++ b/schema/model.py
@@ -1 +1,65 @@
-raise NotImplementedError("implement schema.model.validate")
+"""Validation for the public versioned configuration contract."""
+
+from collections.abc import Mapping
+
+from .errors import DuplicateKeyError, InvalidTypeError, UnknownKeyError, UnknownVersionError
+
+
+_KEYS = {
+    1: ("version", "timeout", "retries", "endpoint"),
+    2: ("version", "timeout_seconds", "max_retries", "endpoint"),
+}
+
+
+def _normalize_key(key: object) -> str:
+    """Return the contract spelling used to compare input keys."""
+    if not isinstance(key, str):
+        return str(key).strip().lower().replace("-", "_")
+    return key.strip().lower().replace("-", "_")
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate(mapping: Mapping[str, object]) -> dict[str, object]:
+    """Validate a v1 or v2 mapping and return a normalized, copied mapping.
+
+    Keys are compared case-insensitively after surrounding whitespace is removed
+    and hyphens are converted to underscores.  The returned dictionary always
+    uses the contract's canonical key spellings and the input is never changed.
+    """
+    if not isinstance(mapping, Mapping):
+        raise InvalidTypeError("configuration must be a mapping")
+
+    normalized: dict[str, object] = {}
+    for key, value in mapping.items():
+        normalized_key = _normalize_key(key)
+        if normalized_key in normalized:
+            raise DuplicateKeyError(f"duplicate key: {normalized_key}")
+        normalized[normalized_key] = value
+
+    version = normalized.get("version")
+    if not _is_int(version):
+        raise InvalidTypeError("version must be an integer")
+    if version not in _KEYS:
+        raise UnknownVersionError(f"unknown version: {version}")
+
+    permitted = set(_KEYS[version])
+    for key in normalized:
+        if key not in permitted:
+            raise UnknownKeyError(f"unknown key: {key}")
+
+    for key in _KEYS[version]:
+        if key not in normalized:
+            raise UnknownKeyError(f"missing key: {key}")
+
+    timeout_key, retries_key = _KEYS[version][1:3]
+    if not _is_int(normalized[timeout_key]):
+        raise InvalidTypeError(f"{timeout_key} must be an integer")
+    if not _is_int(normalized[retries_key]):
+        raise InvalidTypeError(f"{retries_key} must be an integer")
+    if not isinstance(normalized["endpoint"], str):
+        raise InvalidTypeError("endpoint must be a string")
+
+    return {key: normalized[key] for key in _KEYS[version]}

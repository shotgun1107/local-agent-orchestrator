@@ -1 +1,19 @@
-raise NotImplementedError("implement the four public config error classes")
+"""Public exceptions raised when a configuration violates its contract."""
+
+from __future__ import annotations
+
+
+class UnknownVersionError(ValueError):
+    """Raised when ``version`` is not a supported configuration version."""
+
+
+class DuplicateKeyError(ValueError):
+    """Raised when two supplied keys have the same normalized spelling."""
+
+
+class UnknownKeyError(ValueError):
+    """Raised when a key is not part of the selected version's contract."""
+
+
+class InvalidTypeError(ValueError):
+    """Raised when a typed configuration value has an invalid type."""
diff --git a/schema/model.py b/schema/model.py
index c191087..7ab197c 100644
--- a/schema/model.py
+++ b/schema/model.py
@@ -1 +1,60 @@
-raise NotImplementedError("implement schema.model.validate")
+"""Validation for the public versioned configuration format."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+from .errors import DuplicateKeyError, InvalidTypeError, UnknownKeyError, UnknownVersionError
+
+
+_V1_KEYS = frozenset(("version", "timeout", "retries", "endpoint"))
+_V2_KEYS = frozenset(("version", "timeout_seconds", "max_retries", "endpoint"))
+
+
+def _normalize_key(key: object) -> str:
+    """Return the contract spelling for a user-provided key."""
+    if not isinstance(key, str):
+        return str(key).strip().lower().replace("-", "_")
+    return key.strip().lower().replace("-", "_")
+
+
+def _is_integer(value: object) -> bool:
+    # ``bool`` is an ``int`` subclass, but is not a configuration integer.
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate(mapping: Mapping[str, object]) -> dict[str, object]:
+    """Validate *mapping* as a v1 or v2 configuration and return a new mapping.
+
+    Keys are canonicalized by trimming, lower-casing, and treating hyphens as
+    underscores.  The input mapping is never modified.
+    """
+    if not isinstance(mapping, Mapping):
+        raise InvalidTypeError("configuration must be a mapping")
+
+    normalized: dict[str, object] = {}
+    for key, value in mapping.items():
+        normalized_key = _normalize_key(key)
+        if normalized_key in normalized:
+            raise DuplicateKeyError("duplicate configuration key: " + normalized_key)
+        normalized[normalized_key] = value
+
+    version = normalized.get("version")
+    if not _is_integer(version):
+        raise InvalidTypeError("version must be an integer")
+    if version not in (1, 2):
+        raise UnknownVersionError("unsupported configuration version: " + str(version))
+
+    allowed = _V1_KEYS if version == 1 else _V2_KEYS
+    for key in normalized:
+        if key not in allowed:
+            raise UnknownKeyError("unknown configuration key: " + key)
+
+    numeric_keys = ("timeout", "retries") if version == 1 else ("timeout_seconds", "max_retries")
+    for key in numeric_keys:
+        if key in normalized and not _is_integer(normalized[key]):
+            raise InvalidTypeError(key + " must be an integer")
+    if "endpoint" in normalized and not isinstance(normalized["endpoint"], str):
+        raise InvalidTypeError("endpoint must be a string")
+
+    return dict(normalized)

+                "status": "implementation_candidate",
+                "purpose": "profile_routing",
+                "fixture_manifests": [{"path": "benchmarks/manifests/sdk-routing-s2-intermediate.yaml", "fixture_ids": [CONFIG_FIXTURE_ID, INCIDENT_FIXTURE_ID]}],

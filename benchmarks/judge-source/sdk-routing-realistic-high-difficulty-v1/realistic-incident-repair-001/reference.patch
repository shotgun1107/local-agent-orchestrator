+def write_runtime_boundary_probe_failure(
+    bundle_root: Path,
+    manifest: RuntimeBoundaryProbeManifest,
+    command: ProbeCommandSpec,
+    *,
+    wrapper_exit_code: int,
+    stdout: bytes,
+    stdout_total: int,
+    stdout_sha256: str,
+    stderr: bytes,
+    stderr_total: int,
+    stderr_sha256: str,
+    duration_ms: int,
+    controller_precondition_ok: bool,
+    controller_postcondition_ok: bool,

{
  "$defs": {
    "RunState": {
      "enum": [
        "DRAFT",
        "READY",
        "RUNNING",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RunStatusTask": {
      "additionalProperties": false,
      "properties": {
        "active_attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Attempt Id"
        },
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        }
      },
      "required": [
        "key",
        "state",
        "attempts",
        "active_attempt_id"
      ],
      "title": "RunStatusTask",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "REPORTED",
        "VERIFYING",
        "SUCCEEDED",
        "RETRYABLE_FAILED",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "SUPERSEDED"
      ],
      "title": "TaskState",
      "type": "string"
    },
    "UsageStatus": {
      "enum": [
        "measured",
        "unknown",
        "unsupported"
      ],
      "title": "UsageStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_usage_statuses": {
      "description": "Per-session measurement availability. unsupported remains unknown to benchmark consumers and is never treated as not_applicable.",
      "items": {
        "$ref": "#/$defs/UsageStatus"
      },
      "title": "Session Usage Statuses",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/RunStatusTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "turns_used": {
      "minimum": 0,
      "title": "Turns Used",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "state",
    "turns_used",
    "tasks",
    "session_usage_statuses"
  ],
  "title": "RunStatusEnvelope",
  "type": "object"
}

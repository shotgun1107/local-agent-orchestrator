{
  "$defs": {
    "InputRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "TaskLimits": {
      "additionalProperties": false,
      "properties": {
        "remaining_attempts": {
          "minimum": 0,
          "title": "Remaining Attempts",
          "type": "integer"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "timeout_seconds",
        "remaining_attempts"
      ],
      "title": "TaskLimits",
      "type": "object"
    },
    "WorkspaceMode": {
      "enum": [
        "read_only",
        "shared_serial_write"
      ],
      "title": "WorkspaceMode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "check_names": {
      "items": {
        "type": "string"
      },
      "title": "Check Names",
      "type": "array"
    },
    "completion_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Completion Criteria",
      "type": "array"
    },
    "dispatch_token": {
      "title": "Dispatch Token",
      "type": "string"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/TaskLimits"
    },
    "read_scope": {
      "items": {
        "type": "string"
      },
      "title": "Read Scope",
      "type": "array"
    },
    "requirements_version": {
      "minimum": 1,
      "title": "Requirements Version",
      "type": "integer"
    },
    "result_schema_path": {
      "title": "Result Schema Path",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "workspace_mode": {
      "$ref": "#/$defs/WorkspaceMode"
    },
    "write_scope": {
      "items": {
        "type": "string"
      },
      "title": "Write Scope",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "attempt_id",
    "requirements_version",
    "dispatch_token",
    "goal",
    "completion_criteria",
    "inputs",
    "read_scope",
    "write_scope",
    "workspace_mode",
    "check_names",
    "limits",
    "result_schema_path"
  ],
  "title": "TaskEnvelope",
  "type": "object"
}

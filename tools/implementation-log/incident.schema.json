{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-orchestrator.invalid/schemas/development-incident-v1.json",
  "title": "OrchestratorDevelopmentIncident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "id",
    "title",
    "status",
    "stage",
    "category",
    "discovered_at",
    "resolved_at",
    "discovered_by",
    "symptom",
    "reproduction",
    "evidence",
    "root_cause",
    "considered_options",
    "resolution",
    "affected_files",
    "regression_tests",
    "verification",
    "remaining_risks",
    "related_commits",
    "source_references"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "const": "orchestrator-development" },
    "id": { "type": "string", "pattern": "^DEV-[0-9]{8}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["open", "investigating", "resolved", "accepted-risk"]
    },
    "stage": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["design", "implementation", "test", "integration", "tooling"]
    },
    "discovered_at": { "type": "string", "format": "date-time" },
    "resolved_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "discovered_by": { "type": "string", "minLength": 1 },
    "symptom": { "type": "string", "minLength": 1 },
    "reproduction": {
      "$ref": "#/$defs/nonEmptyStringList",
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "detail"],
        "properties": {
          "kind": {
            "enum": [
              "direct-observation",
              "reproducible-test",
              "source-inspection",
              "review-finding",
              "inference"
            ]
          },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "root_cause": { "type": "string" },
    "considered_options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "decision", "reason"],
        "properties": {
          "option": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["adopted", "rejected", "deferred"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resolution": { "type": "string" },
    "affected_files": { "$ref": "#/$defs/nonEmptyStringList" },
    "regression_tests": { "$ref": "#/$defs/nonEmptyStringList" },
    "verification": { "$ref": "#/$defs/nonEmptyStringList" },
    "remaining_risks": { "$ref": "#/$defs/nonEmptyStringList" },
    "related_commits": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
    },
    "source_references": { "$ref": "#/$defs/nonEmptyStringList" }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["resolved", "accepted-risk"] }
        }
      },
      "then": {
        "properties": {
          "resolved_at": { "type": "string", "format": "date-time" },
          "root_cause": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 },
          "regression_tests": { "minItems": 1 },
          "verification": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["open", "investigating"] }
        }
      },
      "then": {
        "properties": {
          "resolved_at": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "accepted-risk" } } },
      "then": { "properties": { "remaining_risks": { "minItems": 1 } } }
    }
  ]
}
